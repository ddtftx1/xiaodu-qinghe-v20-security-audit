<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="24sp"
            android:id="@+id/tx_notice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/headset_notice_mmx"/>
        <View
            android:id="@+id/view1"
            android:layout_width="match_parent"
            android:layout_height="80dp"/>
        <TextView
            android:textSize="24sp"
            android:textColor="#ff0000"
            android:id="@+id/notice_headset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/plugin_notice_mmx"/>
        <View
            android:id="@+id/view2"
            android:layout_width="match_parent"
            android:layout_height="80dp"/>
        <TextView
            android:textSize="24sp"
            android:textColor="#ff0000"
            android:id="@+id/inseart_headset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/please_press_answer_key_mmx"/>
        <TextView
            android:textSize="24sp"
            android:textColor="#ff0000"
            android:id="@+id/mic_headset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/please_test_audio_size_mmx"/>
    </LinearLayout>
    <include
        android:id="@+id/result_btn"
        layout="@layout/result_btn_layout"/>
</LinearLayout>
