<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <SwitchPreference
        android:title="@string/uboot_switch_title"
        android:key="uboot_log_switch"
        android:defaultValue="false"/>
    <SwitchPreference
        android:title="@string/last_kmsg_switch_title"
        android:key="last_kmsg_switch"
        android:defaultValue="false"/>
    <SwitchPreference
        android:title="@string/kernel_log_switch_title"
        android:key="kernel_log_switch"
        android:defaultValue="false"/>
    <SwitchPreference
        android:title="@string/android_log_switch_title"
        android:key="android_log_switch"
        android:defaultValue="false"/>
    <SwitchPreference
        android:title="@string/cap_log_switch_title"
        android:key="cap_log_switch"
        android:defaultValue="false"/>
    <EditTextPreference
        android:singleLine="true"
        android:selectAllOnFocus="true"
        android:maxLength="10"
        android:numeric="integer"
        android:title="@string/ap_cap_log_packet_length"
        android:key="cap_len"
        android:defaultValue="3000"/>
    <SwitchPreference
        android:title="@string/hci_log_switch_title"
        android:key="hci_log_switch"
        android:defaultValue="false"/>
    <SwitchPreference
        android:title="@string/thermal_log_switch_title"
        android:key="thermal_log_switch"
        android:defaultValue="false"/>
</PreferenceScreen>
