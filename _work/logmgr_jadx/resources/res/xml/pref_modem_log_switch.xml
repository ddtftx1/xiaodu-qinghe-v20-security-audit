<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <SwitchPreference
        android:title="@string/ps_log_switch_title"
        android:key="ps_log_switch"
        android:defaultValue="false"/>
    <ListPreference
        android:entries="@array/ps_log_level_titles"
        android:title="@string/ps_log_level_title"
        android:key="ps_log_level"
        android:defaultValue="1"
        android:entryValues="@array/ps_log_level_values"/>
    <SwitchPreference
        android:title="@string/cp_audio_log_switch_title"
        android:key="cp_audio_log_switch"
        android:defaultValue="false"/>
    <SwitchPreference
        android:title="@string/physical_log_switch_title"
        android:key="physical_log_switch"
        android:defaultValue="false"/>
    <ListPreference
        android:entries="@array/physical_layer_level_titles"
        android:title="@string/physical_log_level_title"
        android:key="physical_log_level"
        android:defaultValue="1"
        android:entryValues="@array/physical_layer_level_values"/>
    <SwitchPreference
        android:title="@string/physical_audio_log_switch_title"
        android:key="physical_audio_log_switch"
        android:defaultValue="false"/>
    <SwitchPreference
        android:title="@string/cp_cap_log_switch_title"
        android:key="cp_cap_log_switch"
        android:defaultValue="false"/>
    <EditTextPreference
        android:singleLine="true"
        android:selectAllOnFocus="true"
        android:maxLength="10"
        android:numeric="integer"
        android:title="@string/modem_cap_log_packet_length"
        android:key="cp_cap_len"
        android:defaultValue="3000"/>
    <SwitchPreference
        android:title="@string/etb_switch_title"
        android:key="etb_switch"
        android:defaultValue="false"/>
</PreferenceScreen>
