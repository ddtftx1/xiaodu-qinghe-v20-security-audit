<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/LinearLayout01"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <ScrollView
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16sp"
                    android:textColor="#ffffff"
                    android:id="@+id/hall_tip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </ScrollView>
        <TableRow
            android:id="@+id/TableRow01"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="#ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status"
                style="@style/itemTextKeyStyle"/>
            <TextView
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/statusTextView"
                android:paddingLeft="10px"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/itemTextValueStyle"/>
        </TableRow>
        <TableRow
            android:id="@+id/TableRow02"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="#ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/voltage"
                style="@style/itemTextKeyStyle"/>
            <TextView
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/voltageTextView"
                android:paddingLeft="10px"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/itemTextValueStyle"/>
        </TableRow>
        <TableRow
            android:id="@+id/TableRow03"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="#ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/plugged"
                style="@style/itemTextKeyStyle"/>
            <TextView
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/pluggedTextView"
                android:paddingLeft="10px"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/itemTextValueStyle"/>
        </TableRow>
        <TableRow
            android:id="@+id/TableRow04"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="#ffffff"
                android:id="@+id/electronicnoteTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/charger_Voltage"
                style="@style/itemTextKeyStyle"/>
            <TextView
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/electronicTextView"
                android:paddingLeft="10px"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/itemTextValueStyle"/>
        </TableRow>
        <TableRow
            android:id="@+id/TableRow05"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="#ffffff"
                android:id="@+id/batteryelectronicnoteTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/charger_electronic"
                style="@style/itemTextKeyStyle"/>
            <TextView
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/batteryelectronicTextView"
                android:paddingLeft="10px"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/itemTextValueStyle"/>
        </TableRow>
        <TableRow
            android:id="@+id/TableRow06"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="#ffffff"
                android:id="@+id/batterytemperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/battery_temperature"
                style="@style/itemTextKeyStyle"/>
            <TextView
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/batterytemperatureTextView"
                android:paddingLeft="10px"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/itemTextValueStyle"/>
        </TableRow>
        <TableRow
            android:id="@+id/TableRow09"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="#ffffff"
                android:id="@+id/battery_electronic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/battery_electronic"
                style="@style/itemTextKeyStyle"/>
            <TextView
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/battery_electronic_tv"
                android:paddingLeft="10px"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/itemTextValueStyle"/>
        </TableRow>
        <TableRow
            android:id="@+id/TableRow08"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="#ffffff"
                android:id="@+id/battery_type_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/battery_type_id"
                style="@style/itemTextKeyStyle"/>
            <TextView
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/battery_type_idextView"
                android:paddingLeft="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/itemTextValueStyle"/>
        </TableRow>
        <TableRow
            android:id="@+id/TableRow07"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/test_resultTextView"
                android:paddingLeft="10px"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/charging_test"
                style="@style/itemTextValueStyle"/>
        </TableRow>
    </LinearLayout>
    <include
        android:id="@+id/result_btn"
        layout="@layout/result_btn_layout"/>
</LinearLayout>
