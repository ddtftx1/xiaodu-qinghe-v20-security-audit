<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="20sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/test_info_title"/>
        <LinearLayout
            android:orientation="vertical"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="20sp"
                android:id="@+id/testinfo_sn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/device_sn"/>
            <TextView
                android:textSize="12sp"
                android:id="@+id/test_info_sn_dec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="20sp"
                android:id="@+id/testinfo_imei"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/test_info_imei"/>
            <TextView
                android:textSize="12sp"
                android:id="@+id/test_info_imei_dec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="20sp"
                android:id="@+id/testinfo_blt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/test_info_blt"/>
            <TextView
                android:textSize="12sp"
                android:id="@+id/test_info_blt_dec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="20sp"
                android:id="@+id/testinfo_wifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wifi_addr"/>
            <TextView
                android:textSize="12sp"
                android:id="@+id/test_info_wifi_dec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="20sp"
                android:id="@+id/testinfo_phase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/test_info_phase_check"/>
            <TextView
                android:textSize="12sp"
                android:id="@+id/test_info_phase_dec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
