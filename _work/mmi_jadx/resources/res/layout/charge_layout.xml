<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/LinearLayout01"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TableRow
            android:id="@+id/TableRow01"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="#ffffff"
                android:id="@+id/TextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/battery_info_notice"
                style="@style/itemTextKeyStyle"/>
        </TableRow>
        <TableRow
            android:id="@+id/TableRow02"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="#ffffff"
                android:id="@+id/TextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/battery_info_power_label"
                style="@style/itemTextKeyStyle"/>
            <TextView
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/power"
                android:paddingLeft="10px"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/itemTextKeyStyle"/>
        </TableRow>
        <TableRow
            android:id="@+id/TableRow03"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="#ffffff"
                android:id="@+id/TextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/battery_info_level_label"
                style="@style/itemTextKeyStyle"/>
            <TextView
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/level"
                android:paddingLeft="10px"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/itemTextKeyStyle"/>
        </TableRow>
        <TableRow
            android:id="@+id/TableRow04"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="#ffffff"
                android:id="@+id/TextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/battery_info_scale_label"
                style="@style/itemTextKeyStyle"/>
            <TextView
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/scale"
                android:paddingLeft="10px"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/itemTextKeyStyle"/>
        </TableRow>
        <TableRow
            android:id="@+id/TableRow05"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="#ffffff"
                android:id="@+id/TextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/battery_info_health_label"
                style="@style/itemTextKeyStyle"/>
            <TextView
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/health"
                android:paddingLeft="10px"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/itemTextKeyStyle"/>
        </TableRow>
        <TableRow
            android:id="@+id/TableRow06"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="#ffffff"
                android:id="@+id/TextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/battery_info_voltage_label"
                style="@style/itemTextKeyStyle"/>
            <TextView
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/voltage"
                android:paddingLeft="10px"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/itemTextKeyStyle"/>
        </TableRow>
        <TableRow
            android:id="@+id/TableRow07"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="#ffffff"
                android:id="@+id/TextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/battery_electronic"
                style="@style/itemTextKeyStyle"/>
            <TextView
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/electronic"
                android:paddingLeft="10px"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/itemTextKeyStyle"/>
        </TableRow>
        <TableRow
            android:id="@+id/TableRow08"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="#ffffff"
                android:id="@+id/TextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/battery_info_temperature_label"
                style="@style/itemTextKeyStyle"/>
            <TextView
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/temperature"
                android:paddingLeft="10px"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/itemTextKeyStyle"/>
        </TableRow>
        <TableRow
            android:id="@+id/TableRow09"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="#ffffff"
                android:id="@+id/TextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/battery_info_technology_label"
                style="@style/itemTextKeyStyle"/>
            <TextView
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/technology"
                android:paddingLeft="10px"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/itemTextKeyStyle"/>
        </TableRow>
        <TableRow
            android:id="@+id/TableRow10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="#ffffff"
                android:id="@+id/TextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/battery_info_uptime"
                style="@style/itemTextKeyStyle"/>
            <TextView
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/uptime"
                android:paddingLeft="10px"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/itemTextKeyStyle"/>
        </TableRow>
        <TableRow
            android:id="@+id/TableRow10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/testResult"
                android:paddingLeft="10px"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/itemTextKeyStyle"/>
        </TableRow>
    </LinearLayout>
    <include
        android:id="@+id/result_btn"
        layout="@layout/result_btn_layout"/>
</LinearLayout>
