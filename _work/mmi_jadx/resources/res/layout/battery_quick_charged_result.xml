<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TableRow
            android:id="@+id/TableRow01"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="#ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status"
                style="@style/itemTextKeyStyle"/>
            <TextView
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/tv_status"
                android:paddingLeft="10px"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/itemTextValueStyle"/>
        </TableRow>
        <TableRow
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="#ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/protocol"
                style="@style/itemTextKeyStyle"/>
            <TextView
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/tv_get_protocol"
                android:paddingLeft="10px"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/itemTextValueStyle"/>
        </TableRow>
        <TableRow
            android:id="@+id/TableRow02"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="#ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/voltage"
                style="@style/itemTextKeyStyle"/>
            <TextView
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/tv_battery_voltage"
                android:paddingLeft="10px"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/itemTextValueStyle"/>
        </TableRow>
        <TableRow
            android:id="@+id/TableRow03"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="#ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/plugged"
                style="@style/itemTextKeyStyle"/>
            <TextView
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/tv_plugged"
                android:paddingLeft="10px"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/itemTextValueStyle"/>
        </TableRow>
        <TableRow
            android:id="@+id/TableRow04"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="#ffffff"
                android:id="@+id/chargervoltageTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/charger_Voltage"
                style="@style/itemTextKeyStyle"/>
            <TextView
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/tv_charger_Voltage"
                android:paddingLeft="10px"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/itemTextValueStyle"/>
        </TableRow>
        <TableRow
            android:id="@+id/TableRow05"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="#ffffff"
                android:id="@+id/chargerelectronicnoteTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/charger_electronic"
                style="@style/itemTextKeyStyle"/>
            <TextView
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/tv_chargerelectronic"
                android:paddingLeft="10px"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/itemTextValueStyle"/>
        </TableRow>
        <TableRow
            android:id="@+id/TableRow06"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="#ffffff"
                android:id="@+id/batterytemperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/battery_temperature"
                style="@style/itemTextKeyStyle"/>
            <TextView
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/tv_batterytemperature"
                android:paddingLeft="10px"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/itemTextValueStyle"/>
        </TableRow>
        <TableRow
            android:id="@+id/TableRow09"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="#ffffff"
                android:id="@+id/battery_electronic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/battery_electronic"
                style="@style/itemTextKeyStyle"/>
            <TextView
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/tv_battery_electronic"
                android:paddingLeft="10px"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/itemTextValueStyle"/>
        </TableRow>
        <TableRow
            android:id="@+id/TableRow07"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/tv_test_result"
                android:paddingLeft="10px"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/charging_test"
                style="@style/itemTextValueStyle"/>
        </TableRow>
    </LinearLayout>
</LinearLayout>
