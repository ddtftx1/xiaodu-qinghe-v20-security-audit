<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <TextView
            android:textSize="17dp"
            android:id="@+id/bt_addr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bt_addr"/>
        <TextView
            android:textSize="17dp"
            android:id="@+id/bt_addr_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="17dp"
            android:id="@+id/bt_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bt_state"/>
        <TextView
            android:textSize="17dp"
            android:id="@+id/bt_state_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="17dp"
            android:id="@+id/bt_device"
            android:paddingTop="20px"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bt_device"/>
        <ScrollView
            android:id="@+id/sv_bt_device_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="17dp"
                android:id="@+id/tv_bt_device_list"
                android:paddingTop="20px"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </ScrollView>
    </LinearLayout>
    <include
        android:id="@+id/result_btn"
        layout="@layout/result_btn_layout"/>
</LinearLayout>
