<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:textSize="24sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tof_calibration_test"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="7">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:background="#333"
            android:paddingLeft="8dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/tof_text_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/offset_calibration_head"/>
            <TextView
                android:textSize="@dimen/tof_text_size"
                android:id="@+id/offset_calibration_judge_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:text="@string/ref_calibration_title"/>
            <TextView
                android:textSize="@dimen/tof_text_size"
                android:id="@+id/spads_calibration_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="80dp"
                android:text="@string/spads_calibration_title"/>
            <TextView
                android:textSize="@dimen/tof_text_size"
                android:id="@+id/ref_calibration_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:text="@string/ref_calibration_title"/>
            <TextView
                android:textSize="@dimen/tof_text_size"
                android:id="@+id/offset_calibration_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:text="@string/offset_calibration_title"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="80dp">
                <Button
                    android:textSize="24sp"
                    android:id="@+id/offset_start_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="START"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:background="#555"
            android:paddingLeft="8dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/tof_text_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cross_talk_calibration_head"/>
            <TextView
                android:textSize="@dimen/tof_text_size"
                android:id="@+id/cross_talk_calibration_judge_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:text="@string/ref_calibration_title"/>
            <TextView
                android:textSize="@dimen/tof_text_size"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="80dp"
                android:text=""/>
            <TextView
                android:textSize="@dimen/tof_text_size"
                android:id="@+id/cross_talk_calibration_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:text="@string/cross_talk_calibration_title"/>
            <TextView
                android:textSize="@dimen/tof_text_size"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:text=""/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="80dp">
                <Button
                    android:textSize="24sp"
                    android:id="@+id/cross_talk_start_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="START"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2">
        <TextView
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text=""/>
    </LinearLayout>
</LinearLayout>
