<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TableTextStyle" parent="">
        <item name="android:textSize">14dp</item>
        <item name="android:typeface">1</item>
        <item name="android:textColor">#ff000000</item>
    </style>
    <style name="TableTextStyleTitle" parent="">
        <item name="android:textSize">15dp</item>
        <item name="android:typeface">1</item>
        <item name="android:textStyle">0x1</item>
        <item name="android:textColor">#ff000000</item>
    </style>
    <style name="TextAppearance.Compat.Notification" parent="@android:style/TextAppearance.Material.Notification">
