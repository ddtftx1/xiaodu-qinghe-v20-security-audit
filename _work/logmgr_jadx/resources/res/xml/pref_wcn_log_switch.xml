<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <SwitchPreference
        android:title="@string/wifi_bt_switch_title"
        android:key="wifi_bt_switch"
        android:defaultValue="false"/>
    <ListPreference
        android:entries="@array/wcn_log_level_titles"
        android:title="@string/wifi_bt_level_title"
        android:key="wifi_bt_level"
        android:defaultValue="1"
        android:entryValues="@array/wcn_log_level_values"/>
    <SwitchPreference
        android:title="@string/gnss_log_switch_title"
        android:key="gnss_log_switch"
        android:defaultValue="false"/>
</PreferenceScreen>
