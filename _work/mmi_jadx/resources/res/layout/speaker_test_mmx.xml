<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/headset_text_size"
            android:id="@+id/tx_notice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/speaker_test_mmx"/>
        <TextView
            android:textSize="24sp"
            android:textColor="#ff0000"
            android:id="@+id/speaker_test"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/speaker_test_notice_mmx"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:textSize="22sp"
                android:textColor="#ff000000"
                android:id="@+id/oneButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="20dp"
                android:text="@string/text_one"
                android:singleLine="true"
                android:layout_weight="1"/>
            <Button
                android:textSize="22sp"
                android:textColor="#ff000000"
                android:id="@+id/twoButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="20dp"
                android:text="@string/text_two"
                android:singleLine="true"
                android:layout_weight="1"/>
            <Button
                android:textSize="22sp"
                android:textColor="#ff000000"
                android:id="@+id/threeButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="20dp"
                android:text="@string/text_three"
                android:singleLine="true"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:textSize="22sp"
                android:textColor="#ff000000"
                android:id="@+id/fourButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="20dp"
                android:text="@string/text_four"
                android:singleLine="true"
                android:layout_weight="1"/>
            <Button
                android:textSize="22sp"
                android:textColor="#ff000000"
                android:id="@+id/fiveButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="20dp"
                android:text="@string/text_five"
                android:singleLine="true"
                android:layout_weight="1"/>
            <Button
                android:textSize="22sp"
                android:textColor="#ff000000"
                android:id="@+id/sixButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="20dp"
                android:text="@string/text_six"
                android:singleLine="true"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:textSize="22sp"
                android:textColor="#ff000000"
                android:id="@+id/sevenButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="20dp"
                android:text="@string/text_seven"
                android:singleLine="true"
                android:layout_weight="1"/>
            <Button
                android:textSize="22sp"
                android:textColor="#ff000000"
                android:id="@+id/eightButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="20dp"
                android:text="@string/text_eight"
                android:singleLine="true"
                android:layout_weight="1"/>
            <Button
                android:textSize="22sp"
                android:textColor="#ff000000"
                android:id="@+id/nineButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="20dp"
                android:text="@string/text_nine"
                android:singleLine="true"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
    <include
        android:id="@+id/result_btn"
        layout="@layout/result_btn_layout"/>
</LinearLayout>
