<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:preference="http://schemas.android.com/apk/res/com.sprd.logmanager"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.sprd.logmanager.logui.SettingPreferenceView
            android:id="@+id/ap_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            preference:checkVisibility="visiable"
            preference:onCheck="true"
            preference:summary="@string/ap_log_summary"
            preference:summaryVisibility="visiable"
            preference:title="@string/ap_log_title"/>
        <View
            android:background="@color/gray"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <com.sprd.logmanager.logui.SettingPreferenceView
            android:id="@+id/modem_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            preference:checkVisibility="visiable"
            preference:onCheck="true"
            preference:summary="@string/modem_log_summary"
            preference:summaryVisibility="visiable"
            preference:title="@string/modem_log_title"/>
        <View
            android:background="@color/gray"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <com.sprd.logmanager.logui.SettingPreferenceView
            android:id="@+id/wcn_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            preference:checkVisibility="visiable"
            preference:onCheck="true"
            preference:summary="@string/connectivity_log_summary"
            preference:summaryVisibility="visiable"
            preference:title="@string/wcn_log_title"/>
        <View
            android:background="@color/gray"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <com.sprd.logmanager.logui.SettingPreferenceView
            android:id="@+id/other_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            preference:checkVisibility="visiable"
            preference:onCheck="true"
            preference:summary="@string/other_log_summary"
            preference:summaryVisibility="visiable"
            preference:title="@string/other_log_title"/>
        <View
            android:background="@color/gray"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
    </LinearLayout>
</ScrollView>
