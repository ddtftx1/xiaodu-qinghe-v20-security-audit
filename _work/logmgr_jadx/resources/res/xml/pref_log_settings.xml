<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="@string/ylog_location_setting">
        <Preference
            android:title="@string/storage_path"
            android:key="change_path"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/global_setting"
        android:key="key_global_setting">
        <SwitchPreference
            android:title="@string/log_to_pc"
            android:key="log_to_pc"
            android:defaultValue="false"/>
        <SwitchPreference
            android:title="@string/log2_sd"
            android:key="log_to_sd"
            android:defaultValue="false"/>
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/ap_setting">
        <EditTextPreference
            android:singleLine="true"
            android:selectAllOnFocus="true"
            android:maxLength="10"
            android:numeric="integer"
            android:title="@string/ap_max_size"
            android:key="ap_single_size"
            android:defaultValue="256"/>
        <EditTextPreference
            android:singleLine="true"
            android:selectAllOnFocus="true"
            android:maxLength="10"
            android:numeric="integer"
            android:title="@string/ap_total_max_size"
            android:key="ap_total_size"
            android:defaultValue="1000"/>
        <SwitchPreference
            android:title="@string/log_override"
            android:key="ap_log_overwrite"
            android:defaultValue="false"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/modem_setting"
        android:key="key_modem_setting">
        <Preference
            android:title="@string/ps_log_level"
            android:key="psLogLevel"/>
        <EditTextPreference
            android:singleLine="true"
            android:selectAllOnFocus="true"
            android:maxLength="10"
            android:numeric="integer"
            android:title="@string/single_log_size"
            android:key="modem_single_size"
            android:defaultValue="256"/>
        <EditTextPreference
            android:singleLine="true"
            android:selectAllOnFocus="true"
            android:maxLength="10"
            android:numeric="integer"
            android:title="@string/internal_log_size"
            android:key="modem_total_internal_size"
            android:defaultValue="256"/>
        <EditTextPreference
            android:singleLine="true"
            android:selectAllOnFocus="true"
            android:maxLength="10"
            android:numeric="integer"
            android:title="@string/external_log_size"
            android:key="modem_total_external_size"
            android:defaultValue="256"/>
        <SwitchPreference
            android:title="@string/log_override"
            android:key="modem_log_overwrite"
            android:defaultValue="false"/>
        <SwitchPreference
            android:title="@string/compress_switch_title"
            android:key="modem_log_compress"
            android:defaultValue="false"/>
        <SwitchPreference
            android:title="@string/modem_log_optimization"
            android:key="modem_log_optimization"
            android:defaultValue="false"/>
        <Preference
            android:title="@string/fulldump"
            android:key="modem_fulldump"/>
        <Preference
            android:enabled="false"
            android:title="@string/modem_log_scene"
            android:key="modem_log_scene"/>
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/connectivity_setting">
        <Preference
            android:title="@string/log_level"
            android:key="wcnLogLevel"/>
        <EditTextPreference
            android:singleLine="true"
            android:selectAllOnFocus="true"
            android:maxLength="10"
            android:numeric="integer"
            android:title="@string/single_log_size"
            android:key="wcn_single_size"
            android:defaultValue="256"/>
        <EditTextPreference
            android:singleLine="true"
            android:selectAllOnFocus="true"
            android:maxLength="10"
            android:numeric="integer"
            android:title="@string/internal_log_size"
            android:key="wcn_total_internal_size"
            android:defaultValue="256"/>
        <EditTextPreference
            android:singleLine="true"
            android:selectAllOnFocus="true"
            android:maxLength="10"
            android:numeric="integer"
            android:title="@string/external_log_size"
            android:key="wcn_total_external_size"
            android:defaultValue="256"/>
        <SwitchPreference
            android:title="@string/log_override"
            android:key="wcn_log_overwrite"
            android:defaultValue="false"/>
        <SwitchPreference
            android:title="@string/compress_switch_title"
            android:key="wcn_log_compress"
            android:defaultValue="false"/>
    </PreferenceCategory>
</PreferenceScreen>
